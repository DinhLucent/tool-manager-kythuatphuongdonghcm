# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG NỀN TẢNG (FREE TIER)
# ==========================================

# 1. Supabase (Free Tier PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"

# 2. Server AI Chuyên Dụng (Gateway / Proxy Target)
# Server nội bộ on-premise hoặc cloud VM chuyên xử lý LLM
AI_BACKEND_ENDPOINT="https://internal-ai-server.phuongdong.vn/v1/chat/completions"
AI_BACKEND_API_KEY="secret-token-between-portal-and-ai-server"
AI_RATE_LIMIT_PER_MINUTE="30"

# 3. Phân Phối Phần Mềm LIS (GitHub Releases & Google Drive)
GITHUB_RELEASE_REPO="phuongdong-med/lis-software-binaries"
GITHUB_TOKEN="ghp_optional_pat_for_higher_rate_limit"

# Google Drive 5TB Backup Folder (Public read with link hoặc Service Account)
GOOGLE_DRIVE_LIS_BACKUP_URL="https://drive.google.com/drive/folders/your-folder-id"

# 4. Host Domain & Auth Restrictions
NEXT_PUBLIC_APP_URL="https://hcm-techhub.vercel.app"
ALLOWED_EMAIL_DOMAIN="@phuongdong.com.vn"
